# ===========================================
# Zenith Wellness API Environment Configuration
# ===========================================
# Copy this file to .env and update with your values
# Generate secrets with: php -r "echo bin2hex(random_bytes(32));"

# ===================
# Application
# ===================
APP_ENV=development
APP_URL=http://localhost:5173
APP_DEBUG=true
PRODUCTION=false

# ===================
# Database
# ===================
DB_HOST=localhost
DB_NAME=zenith_wellness
DB_USER=root
DB_PASS=
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/zenith

# ===================
# Security (CHANGE IN PRODUCTION!)
# ===================
JWT_SECRET=change-this-to-a-strong-random-32-character-secret
ENCRYPTION_KEY=change-this-to-another-strong-32-char-key

# ===================
# Sales Toggle (maintenance mode)
# ===================
# Set to true to enable payments. Set to false to pause new sales while existing users retain access.
SALES_ENABLED=false

# ===================
# Payment Gateways
# ===================
# Active gateway: stripe | paystack | flutterwave
ACTIVE_PAYMENT_GATEWAY=stripe
PAYMENT_CURRENCY=USD

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_PUBLIC_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Paystack (https://dashboard.paystack.com/#/settings/developer)
PAYSTACK_PUBLIC_KEY=pk_test_your_key
PAYSTACK_SECRET_KEY=sk_test_your_key
PAYSTACK_WEBHOOK_SECRET=

# Flutterwave (https://dashboard.flutterwave.com/settings/apis)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your_key
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_key
FLUTTERWAVE_WEBHOOK_SECRET=generate-a-strong-hmac-secret-here-used-for-webhook-verification

# ===================
# Email (SMTP)
# ===================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_EMAIL=noreply@zenithwellness.com
SMTP_FROM_NAME=Zenith Wellness
SMTP_SECURE=tls

# ===================
# AI Services
# ===================
GEMINI_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=your_openrouter_api_key

# ===================
# Error Monitoring (Optional)
# ===================
SENTRY_DSN=

# ===================
# CORS (comma-separated origins)
# ===================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ===================
# Payment Quotes
# ===================
PAYMENT_QUOTE_SECRET=

# ===================
# Meta Conversions API
# ===================
META_PIXEL_ID=
META_ACCESS_TOKEN=

# ===================
# Google Analytics 4
# ===================
GA4_MEASUREMENT_ID=

# ===================
# Rate Limiting
# ===================
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW=60

# ===================
# Experiment Engine (A/B Testing)
# ===================
EXPERIMENT_ENGINE_ENABLED=true
EXPERIMENT_HOLDOUT_PERCENT=0
EXPERIMENT_MC_SAMPLES=20000

# ===================
# AI Variant Generation
# ===================
EXPERIMENT_AI_GENERATION_ENABLED=false
VARIANT_GEN_MODEL=gemini-1.5-flash
VARIANT_GEN_MAX_CANDIDATES=5
VARIANT_GEN_MONTHLY_TOKEN_CEILING=1000000
INSIGHT_DECAY_DAYS=90
