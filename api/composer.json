{
    "name": "zenith/wellness-api",
    "description": "Zenith Wellness Platform API",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "stripe/stripe-php": "^13.0",
        "yabacon/paystack-php": "^2.2",
        "phpmailer/phpmailer": "^6.9",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "sentry/sentry": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Zenith\\": "src/"
        },
        "classmap": [
            "controllers/",
            "services/",
            "middleware/",
            "config/"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    }
}
